; Engine configuration for Vibecoder Runner
[application]

config/name="Vibecoder Runner"
config/description="A 2D endless runner. You are a vibecoder at 3 AM, shipping a critical feature while the AI underworld throws everything at you."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/save.gd"
Audio="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=2
window/size/stretch/mode="canvas_items"
window/size/stretch/aspect="expand"
window/stretch/scale_mode="integer"

