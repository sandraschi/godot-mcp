{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Godot MCP",
  "version": "0.4.0",
  "identifier": "com.sandraschi.godot-mcp",
  "build": {
    "frontendDist": "../webapp/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Godot MCP",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/godot-mcp-backend.exe",
      "resources/.env.example"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
